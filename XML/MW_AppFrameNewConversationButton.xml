<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Button name="MW_AppFrameNewConversationButton" mixin="AppFrameNewConversationButtonMixin" virtual="true">
        <Size y="48" />
        
		<NormalTexture parentKey="NormalTexture" atlas="pvpqueue-button-casual-up"/>
		<HighlightTexture parentKey="HighlightTexture" atlas="pvpqueue-button-casual-highlight" alphaMode="ADD"/>
        
        <Frames>
            <Button parentKey="AddButton" inherits="MW_PlusButton">
                <Size x="22" y="22"/>

                <Anchors>
                    <Anchor point="LEFT" x="6"/>
                </Anchors>
            </Button>

            <EditBox parentKey="NameBox" inherits="InputBoxTemplate, AutoCompleteEditBoxTemplate" hidden="false" autoFocus="false">
                <Size y="28"/>
                <Anchors>
                    <Anchor point="LEFT" x="36"/>
                    <Anchor point="RIGHT" x="-16"/>
                </Anchors>
            </EditBox>
        </Frames>
    </Button>
</Ui>