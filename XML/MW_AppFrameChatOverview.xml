<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MW_AppFrameChatOverview" inherits="BackdropTemplate" mixin="AppFrameChatOverviewMixin" virtual="true">
        <Frames>
            <Frame parentKey="Header" inherits="MW_AppFrameChatOverviewHeader" hidden="true">
                <Size y="48" />
                
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
            </Frame>

            <Frame parentKey="EditBoxContainer" inherits="BackdropTemplate" hidden="true">
                <Size y="36" />
                
                <Anchors>
                    <Anchor point="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>

                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="Background" setAllPoints="true">
                            <Color r="0.1" g="0.1" b="0.1" a="0.9" />
                        </Texture>
                    </Layer>
                </Layers>

                <Frames>
                    <EditBox parentKey="ChatBox" inherits="InputBoxTemplate, AutoCompleteEditBoxTemplate" hidden="false" autoFocus="false">
                        <Size y="28"/>
                        <Anchors>
                            <Anchor point="LEFT" x="14"/>
                            <Anchor point="RIGHT" x="-10"/>
                        </Anchors>
                    </EditBox>
                </Frames>
            </Frame>

            <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
                <Size x="34" />
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.Header" relativePoint="BOTTOMRIGHT" y="-4"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.EditBoxContainer" relativePoint="TOPRIGHT" y="4"/>
                </Anchors>
            </EventFrame>

            <Frame parentKey="ScrollBox" inherits="WowScrollBoxList" >
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.Header" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.EditBoxContainer" relativePoint="TOPRIGHT" x="-34"/>
                </Anchors>
            </Frame>
        </Frames>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true">
                    <Color r="1" g="1" b="1" a="1" />
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Frame>
</Ui>