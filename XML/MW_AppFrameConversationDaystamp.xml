<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Button name="MW_AppFrameConversationDaystamp" mixin="AppFrameConversationDaystampMixin" virtual="true">
        <Size x="200" y="20"/>
        
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background">
                    <Size y="20" />
                    <Anchors>
                        <Anchor point="LEFT"/>
                        <Anchor point="RIGHT"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="1" />
                </Texture>
                
                <MaskTexture parentKey="BackgroundMask" atlas="shop-card-wide-mask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" setAllPoints="true">
					<MaskedTextures>
						<MaskedTexture childKey="Background"/>
					</MaskedTextures>
				</MaskTexture>
            </Layer>

            <Layer level="OVERLAY">
                <FontString parentKey="Date" font="SystemFont_Tiny" justifyH="LEFT" justifyV="MIDDLE">
                    <Color r="0.3" g="0.3" b="0.3" a="1" />
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Button>
</Ui>