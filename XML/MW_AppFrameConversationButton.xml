<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Button name="MW_AppFrameConversationButton" mixin="AppFrameConversationButtonMixin" registerForClicks="LeftButtonUp, RightButtonUp" virtual="true">
        <Size y="52" />
        
		<NormalTexture atlas="Ui-Dialog-New-Button-Default"/>
		<PushedTexture atlas="Ui-Dialog-New-Button-Down">
            <Anchors>
                <Anchor point="TOPLEFT" x="5" y="-4"/>
                <Anchor point="BOTTOMRIGHT" y="10"/>
            </Anchors>
        </PushedTexture>
		<HighlightTexture atlas="Ui-Dialog-New-Button-Hover" alphaMode="ADD"/>

        <Layers>
            <Layer level="OVERLAY">
                <!--<Texture parentKey="Background" atlas="Ui-Dialog-New-Background" setAllPoints="true"/>!-->

                <Texture parentKey="Picture">
                    <Size x="32" y="32" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="7" y="-7"/>
                    </Anchors>
                </Texture>

				<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Size x="28" y="28"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Picture" relativePoint="CENTER"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Picture"/>
					</MaskedTextures>
				</MaskTexture>

                <FontString parentKey="Name" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Picture" relativePoint="TOPRIGHT" x="2" y="-2"/>
                    </Anchors>
                    <!--<Color r="0" g="0" b="0" a="1" />!-->
                </FontString>

                <Texture parentKey="NewMessages" hidden="true">
                    <Size x="22" y="14" />
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-7" y="15" />
                    </Anchors>
                    <Color r="0.1" g="0.7" b="0.1" a="1" />
                </Texture>

				<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Size x="20" y="14"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.NewMessages"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="NewMessages"/>
					</MaskedTextures>
				</MaskTexture>

                <FontString parentKey="NumberOfNewMessages" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.NewMessages" />
                    </Anchors>
                </FontString>

                <FontString parentKey="LastMessage" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE" wordwrap="false" nonspacewrap="false">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.Picture" relativePoint="BOTTOMRIGHT" x="2" y="2"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.NewMessages" relativePoint="BOTTOMLEFT" x="-4"/>
                    </Anchors>
                    <Color r="0.4" g="0.4" b="0.4" a="1" />
                </FontString>

                <FontString parentKey="Time" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPRIGHT" x="-7" y="-9" />
                    </Anchors>
                    <Color r="0.4" g="0.4" b="0.4" a="1" />
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnClick method="OnClick" />
        </Scripts>
    </Button>
</Ui>