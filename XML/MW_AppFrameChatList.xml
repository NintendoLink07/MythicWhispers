<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MW_AppFrameChatList" inherits="BackdropTemplate" mixin="AppFrameChatListMixin" virtual="true">
        <Frames>
            <Frame parentKey="ScrollBox" inherits="WowScrollBoxList" >
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" y="4"/>
                </Anchors>
            </Frame>

            <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" y="-4"/>
                    <Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" y="4"/>
                </Anchors>
            </EventFrame>
    
            <Button parentKey="Tab1" id="1" text="Whispers" inherits="PanelTabButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" />
                </Anchors>
                <Scripts>
                    <OnLoad>
                        self.frameName = "Whispers"
                    </OnLoad>
                    <OnClick>
                        self:GetParent().selectedTab = self:GetID()
                        self:GetParent():OnShow()
                        PanelTemplates_SetTab(self:GetParent(), self:GetID())
                    </OnClick>
                </Scripts>
            </Button>

            <Button parentKey="Tab2" id="2" text="Friends" inherits="PanelTabButtonTemplate" hidden="true">
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.Tab1" relativePoint="RIGHT"/>
                </Anchors>
                
                <Scripts>
                    <OnLoad>
                        self.frameName = "Friends"
                    </OnLoad>
                    <OnClick>
                        self:GetParent().selectedTab = self:GetID()
                        self:GetParent():OnShow()
                        PanelTemplates_SetTab(self:GetParent(), self:GetID())
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Overlay" setAllPoints="true" hidden="true">
                    <Color r="1" g="1" b="1" a="0.5" />
                </Texture>
            </Layer>

            <Layer level="BACKGROUND" textureSubLevel="-1">
                <Texture parentKey="Background" setAllPoints="true">
                    <Color r="1" g="1" b="1" a="1" />
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnShow method="OnShow" />
        </Scripts>
    </Frame>
</Ui>