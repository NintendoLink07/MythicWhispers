<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MW_AppFrame" inherits="BackdropTemplate" mixin="AppFrameMixin" movable="true" toplevel="true" parent="UIParent" clampedToScreen="true" registerForDrag="LeftButton" virtual="true">
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Frames>
            <Frame parentKey="TitleBar" inherits="BackdropTemplate">
                <Size y="24" />

                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
                
                <Frames>
                    <Frame parentKey="VoiceChatServiceStatus" inherits="MW_AppFrameConnectionStatusFrameTemplate">
                        <Size x="16" y="16" />
                        <Anchors>
                            <Anchor point="LEFT" x="4"/>
                        </Anchors>

                        <Scripts>
                            <OnEnter>
                                self:GetParent():GetParent():CheckServiceStatus(self)

                            </OnEnter>
                            <OnLeave function="GameTooltip_Hide" />
                        </Scripts>
                    </Frame>
                    
                    <Frame parentKey="VoiceChatCallStatus" inherits="MW_AppFrameConnectionStatusFrameTemplate">
                        <Size x="16" y="16" />
                        <Anchors>
                            <Anchor point="LEFT" relativeKey="$parent.VoiceChatServiceStatus" relativePoint="RIGHT" x="4"/>
                        </Anchors>

                        <Scripts>
                            <OnEnter>
                                self:GetParent():GetParent():CheckCallStatus(self)

                            </OnEnter>
                            <OnLeave function="GameTooltip_Hide" />
                        </Scripts>
                    </Frame>

                    <Button parentKey="CloseButton" inherits="UIPanelCloseButton" topLevel="true">
                        <Size x="20" y="20" />
                        <Anchors>
                            <Anchor point="RIGHT" x="-3" />
                        </Anchors>
						<Scripts>
							<OnClick>
                                self:GetParent():GetParent():Hide()
							</OnClick>
						</Scripts>
					</Button>
                </Frames>

                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Title" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE" text="MythicWhispers - App Mode">
                            <Anchors>
                                <Anchor point="CENTER"/>
                            </Anchors>
                        </FontString>
                    </Layer>

                    <Layer level="BACKGROUND">
                        <Texture parentKey="Background" setAllPoints="true">
                            <Color r="1" g="1" b="1" a="1" />
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>

            <Frame parentKey="ChatList" inherits="MW_AppFrameChatList">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.TitleBar" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMLEFT"/>
                </Anchors>
            </Frame>

            <Frame parentKey="ChatOverview" inherits="MW_AppFrameChatOverview">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.TitleBar" relativePoint="BOTTOMRIGHT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
            </Frame>

            <Frame parentKey="VoiceChatRoom" inherits="MW_AppFrameVoiceChatRoom">
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.TitleBar" relativePoint="BOTTOMRIGHT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>

            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
    </Frame>
</Ui>