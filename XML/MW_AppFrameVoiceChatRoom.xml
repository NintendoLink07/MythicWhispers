<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Frame name="MW_AppFrameVoiceChatRoom" inherits="BackdropTemplate" mixin="AppFrameVoiceChatRoomMixin" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true">
                    <Color r="1" g="1" b="1" a="1" />
                </Texture>
            </Layer>
        </Layers>

        <Frames>
            <Frame parentKey="ChatContainer" inherits="BackdropTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>

                <Frames>
                    <Frame parentKey="EditBoxContainer" inherits="BackdropTemplate">
                        <Size y="36" />
                        
                        <Anchors>
                            <Anchor point="BOTTOMLEFT"/>
                            <Anchor point="BOTTOMRIGHT"/>
                        </Anchors>

                        <Layers>
                            <Layer level="BACKGROUND">
                                <Texture parentKey="Background" setAllPoints="true">
                                    <Color r="0.1" g="0.1" b="0.1" a="0.9" />
                                </Texture>
                            </Layer>
                        </Layers>

                        <Frames>
                            <EditBox parentKey="ChatEditBox" inherits="InputBoxTemplate, AutoCompleteEditBoxTemplate" hidden="false" autoFocus="false">
                                <Size y="28"/>
                                <Anchors>
                                    <Anchor point="LEFT" x="14"/>
                                    <Anchor point="RIGHT" x="-10"/>
                                </Anchors>
                            </EditBox>
                        </Frames>
                    </Frame>

                    <EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
                        <Size x="34" />
                        <Anchors>
                            <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" y="-4"/>
                            <Anchor point="BOTTOMRIGHT" relativeKey="$parent.EditBoxContainer" relativePoint="TOPRIGHT" y="4"/>
                        </Anchors>
                    </EventFrame>

                    <ScrollingMessageFrame parentKey="Chat" mixin="ChatFrameMixin">
                        <Anchors>
                            <Anchor point="TOPLEFT" x="4"/>
                            <Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBar" relativePoint="BOTTOMLEFT" x="-4"/>
                        </Anchors>
                    </ScrollingMessageFrame>
                </Frames>
            </Frame>
            
            <Frame parentKey="GridManageFrame">
                <Anchors>
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent.ChatContainer" relativePoint="BOTTOMLEFT"/>
                </Anchors>

                <Frames>
                    <Frame parentKey="Grid" inherits="StaticGridLayoutFrame" />
                </Frames>
            </Frame>
        </Frames>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnEvent method="OnEvent" />
        </Scripts>
    </Frame>
</Ui>