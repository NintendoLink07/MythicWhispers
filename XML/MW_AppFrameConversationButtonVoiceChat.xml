<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Button name="MW_AppFrameConversationButtonVoiceChat" mixin="AppFrameConversationButtonVoiceChatMixin" registerForClicks="LeftButtonUp, RightButtonUp" virtual="true">   
        <Size x="100" y="48" />

		<PushedTexture atlas="pvpqueue-button-casual-down"/>
        <HighlightTexture atlas="BattleBar-SwapPetFrame-Highlight" >
            <Anchors>
                <Anchor point="TOPLEFT" x="3" y="-3"/>
                <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
            </Anchors>
        </HighlightTexture>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" atlas="pvpqueue-button-casual-up" setAllPoints="true" />
                <Texture parentKey="HoverAdded" atlas="groupfinder-highlightbar-green" alphaMode="ADD">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="3" y="-3"/>
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="OVERLAY">
                <Texture parentKey="Picture">
                    <Size x="40" y="40" />
                    <Anchors>
                        <Anchor point="LEFT" x="4"/>
                    </Anchors>
                </Texture>

				<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Size x="36" y="36"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Picture" relativePoint="CENTER"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Picture"/>
					</MaskedTextures>
				</MaskTexture>

                <FontString parentKey="Name" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Picture" relativePoint="TOPRIGHT" x="4" y="-4"/>
                    </Anchors>
                    <!--<Color r="0" g="0" b="0" a="1" />!-->
                </FontString>

                <Texture parentKey="NewMessages" hidden="true">
                    <Size x="14" y="14" />
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-6" y="8" />
                    </Anchors>
                    <Color r="0.1" g="0.7" b="0.1" a="1" />
                </Texture>

				<MaskTexture parentKey="CircleMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.NewMessages" relativePoint="CENTER"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="NewMessages"/>
					</MaskedTextures>
				</MaskTexture>

                <FontString parentKey="NumberOfNewMessages" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.NewMessages" />
                    </Anchors>
                </FontString>

                <FontString parentKey="LastMessage" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE" wordwrap="false" nonspacewrap="false">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.Picture" relativePoint="BOTTOMRIGHT" x="4" y="4"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.NewMessages" relativePoint="BOTTOMLEFT" x="-4"/>
                    </Anchors>
                    <Color r="0.4" g="0.4" b="0.4" a="1" />
                </FontString>

                <FontString parentKey="Time" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE">
                    <Anchors>
                        <Anchor point="TOPRIGHT" x="-6" y="-8" />
                    </Anchors>
                    <Color r="0.4" g="0.4" b="0.4" a="1" />
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad method="OnLoad" />
            <OnClick method="OnClick" />
        </Scripts>
    </Button>
</Ui>