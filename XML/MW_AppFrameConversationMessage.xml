<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\..\FrameXML\UI.xsd">
    <Button name="MW_AppFrameConversationMessage" mixin="AppFrameConversationMessageMixin" virtual="true">
        <Size x="200"/>
        
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" setAllPoints="true">
                    <Color r="1" g="1" b="1" a="1" />
                </Texture>
                
                <MaskTexture parentKey="BackgroundMask" atlas="shop-card-wide-mask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" setAllPoints="true">
					<MaskedTextures>
						<MaskedTexture childKey="Background"/>
					</MaskedTextures>
				</MaskTexture>
            </Layer>

            <Layer level="OVERLAY">
                <FontString parentKey="Time" font="SystemFont_Tiny2" justifyH="LEFT" justifyV="MIDDLE">
                    <Color r="0.3" g="0.3" b="0.3" a="1" />
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-4" y="2" />
                    </Anchors>
                </FontString>

                <FontString parentKey="Message" font="SystemFont_Med1" justifyH="LEFT" justifyV="MIDDLE" nonspacewrap="true" wordwrap="true">
                    <Color r="0" g="0" b="0" a="1" />
                    <Anchors>
                        <Anchor point="TOPLEFT" x="4" />
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Time" relativePoint="BOTTOMLEFT" x="-4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Button>
</Ui>